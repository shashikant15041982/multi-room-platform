<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Multi-Room Platform - Session 4 (Context Integrity)</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
            color: #333;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        header {
            text-align: center;
            color: white;
            margin-bottom: 30px;
        }

        header h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
        }

        header p {
            font-size: 1.1em;
            opacity: 0.9;
        }

        .home-view {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .room-card {
            background: white;
            border-radius: 10px;
            padding: 20px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .room-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 12px rgba(0, 0, 0, 0.15);
        }

        .room-card h2 {
            color: #667eea;
            margin-bottom: 15px;
            font-size: 1.5em;
        }

        .card-stat {
            margin: 10px 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 0;
            border-bottom: 1px solid #eee;
        }

        .card-stat:last-child {
            border-bottom: none;
        }

        .card-stat label {
            font-weight: 600;
            color: #666;
        }

        .card-stat value {
            color: #667eea;
            font-weight: bold;
            font-size: 1.1em;
        }

        .ai-helpers {
            margin: 15px 0;
            padding: 10px;
            background: #f5f5f5;
            border-radius: 5px;
        }

        .ai-helpers label {
            display: block;
            font-weight: 600;
            margin-bottom: 8px;
            color: #666;
        }

        .helpers-list {
            display: flex;
            gap: 5px;
            flex-wrap: wrap;
        }

        .helper-badge {
            background: #667eea;
            color: white;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.85em;
        }

        .integrity-badge {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.85em;
            font-weight: bold;
            margin-top: 8px;
        }

        .integrity-badge.verified {
            background: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }

        .integrity-badge.pending {
            background: #fff3cd;
            color: #856404;
            border: 1px solid #ffeeba;
        }

        .relay-indicator {
            margin-top: 10px;
            padding: 8px;
            background: #fff3cd;
            border-left: 4px solid #ffc107;
            border-radius: 3px;
            font-size: 0.9em;
        }

        .relay-indicator em {
            color: #ff6b6b;
            font-weight: bold;
        }

        .btn {
            background: #667eea;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
            font-size: 1em;
            margin-top: 15px;
            width: 100%;
            transition: background 0.3s ease;
        }

        .btn:hover:not(:disabled) {
            background: #5568d3;
        }

        .btn:disabled {
            background: #ccc;
            cursor: not-allowed;
            opacity: 0.6;
        }

        .room-view {
            display: none;
            background: white;
            border-radius: 10px;
            padding: 30px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .room-view.active {
            display: block;
        }

        .room-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            border-bottom: 2px solid #667eea;
            padding-bottom: 15px;
        }

        .room-header h2 {
            color: #667eea;
            font-size: 2em;
        }

        .back-btn {
            background: #667eea;
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 5px;
            cursor: pointer;
            font-size: 0.95em;
        }

        .back-btn:hover {
            background: #5568d3;
        }

        .tabs {
            display: flex;
            gap: 10px;
            margin-bottom: 30px;
            border-bottom: 2px solid #eee;
            flex-wrap: wrap;
        }

        .tab-btn {
            background: none;
            border: none;
            padding: 12px 20px;
            cursor: pointer;
            font-size: 1em;
            color: #999;
            border-bottom: 3px solid transparent;
            transition: all 0.3s ease;
        }

        .tab-btn:hover {
            color: #667eea;
        }

        .tab-btn.active {
            color: #667eea;
            border-bottom-color: #667eea;
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

        .code-section {
            background: #f5f5f5;
            padding: 15px;
            border-radius: 5px;
            margin-bottom: 15px;
        }

        .code-section textarea {
            width: 100%;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 5px;
            font-family: 'Courier New', monospace;
            font-size: 0.95em;
            min-height: 100px;
        }

        .execution-log {
            background: #f5f5f5;
            padding: 15px;
            border-radius: 5px;
            margin-top: 15px;
            max-height: 400px;
            overflow-y: auto;
        }

        .log-entry {
            padding: 10px;
            background: white;
            border-left: 4px solid #667eea;
            margin-bottom: 10px;
            border-radius: 3px;
        }

        .log-entry:last-child {
            margin-bottom: 0;
        }

        .log-entry-time {
            font-size: 0.85em;
            color: #999;
            margin-bottom: 5px;
        }

        .log-entry-detail {
            display: flex;
            justify-content: space-between;
            font-size: 0.95em;
            margin: 3px 0;
        }

        .log-entry-detail label {
            font-weight: 600;
            color: #666;
        }

        .log-entry-detail value {
            color: #667eea;
            font-weight: bold;
        }

        .email-item {
            background: #f5f5f5;
            padding: 15px;
            border-left: 4px solid #28a745;
            margin-bottom: 15px;
            border-radius: 3px;
        }

        .email-item:last-child {
            margin-bottom: 0;
        }

        .email-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
        }

        .email-to {
            font-weight: 600;
            color: #333;
        }

        .email-time {
            font-size: 0.85em;
            color: #999;
        }

        .email-subject {
            font-weight: 600;
            color: #667eea;
            margin: 8px 0;
        }

        .email-preview {
            color: #666;
            font-size: 0.95em;
            margin: 8px 0;
        }

        .email-status {
            display: inline-block;
            background: #28a745;
            color: white;
            padding: 3px 8px;
            border-radius: 3px;
            font-size: 0.85em;
            font-weight: bold;
        }

        .relay-event {
            background: #f0f3ff;
            padding: 15px;
            border-left: 4px solid #667eea;
            margin-bottom: 15px;
            border-radius: 3px;
        }

        .relay-event:last-child {
            margin-bottom: 0;
        }

        .relay-header {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 10px;
        }

        .relay-arrow {
            font-weight: bold;
            color: #667eea;
            font-size: 1.2em;
        }

        .relay-details {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 10px;
            margin-top: 10px;
            font-size: 0.9em;
        }

        .relay-detail {
            background: white;
            padding: 8px;
            border-radius: 3px;
        }

        .relay-detail-label {
            color: #999;
            font-size: 0.85em;
            margin-bottom: 3px;
        }

        .relay-detail-value {
            color: #667eea;
            font-weight: bold;
        }

        .integrity-section {
            background: #f0f8ff;
            padding: 10px;
            border-left: 4px solid #2196F3;
            border-radius: 3px;
            margin-top: 8px;
            font-size: 0.9em;
        }

        .integrity-check {
            display: flex;
            align-items: center;
            gap: 8px;
            margin: 5px 0;
        }

        .integrity-check-icon {
            font-size: 1.2em;
        }

        .integrity-check-icon.verified {
            color: #28a745;
        }

        .integrity-check-icon.failed {
            color: #dc3545;
        }

        .integrity-hash {
            font-family: 'Courier New', monospace;
            font-size: 0.8em;
            color: #666;
            word-break: break-all;
            background: white;
            padding: 8px;
            border-radius: 3px;
            margin-top: 8px;
            border: 1px solid #e0e0e0;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }

        .stat-card {
            background: #f5f5f5;
            padding: 20px;
            border-radius: 8px;
            border-left: 4px solid #667eea;
        }

        .stat-card-title {
            font-weight: 600;
            color: #333;
            margin-bottom: 15px;
            font-size: 1.1em;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .stat-card-title .ai-name {
            background: #667eea;
            color: white;
            padding: 2px 8px;
            border-radius: 3px;
            font-size: 0.9em;
        }

        .stat-row {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            border-bottom: 1px solid #e0e0e0;
        }

        .stat-row:last-child {
            border-bottom: none;
        }

        .stat-label {
            color: #666;
            font-size: 0.95em;
        }

        .stat-value {
            color: #667eea;
            font-weight: bold;
        }

        .context-bar {
            background: #e0e0e0;
            height: 20px;
            border-radius: 10px;
            overflow: hidden;
            margin: 8px 0;
        }

        .context-fill {
            background: linear-gradient(90deg, #667eea, #764ba2);
            height: 100%;
            transition: width 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 0.75em;
            font-weight: bold;
        }

        .empty-state {
            text-align: center;
            color: #999;
            padding: 40px;
        }

        .empty-state-icon {
            font-size: 3em;
            margin-bottom: 10px;
        }

        .integrity-report {
            background: #e8f5e9;
            border: 1px solid #4caf50;
            padding: 12px;
            border-radius: 5px;
            margin: 10px 0;
        }

        .integrity-report.failed {
            background: #ffebee;
            border-color: #f44336;
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>🔐 Multi-Room Platform</h1>
            <p>AI Helper Relay System - Session 4: Context Passing & Integrity</p>
        </header>

        <div id="homeView" class="home-view"></div>
        <div id="roomViews"></div>
    </div>

    <script>
        function simpleHash(str) {
            try {
                let hash = 0;
                if (str.length === 0) return '0';
                for (let i = 0; i < str.length; i++) {
                    const char = str.charCodeAt(i);
                    hash = ((hash << 5) - hash) + char;
                    hash = hash & hash;
                }
                return Math.abs(hash).toString(16).padStart(8, '0');
            } catch (e) {
                return 'error';
            }
        }

        function generateContextHash(messages) {
            try {
                if (!Array.isArray(messages)) return '';
                const concatenated = messages.map(m => m.text || '').join('|');
                return simpleHash(concatenated);
            } catch (e) {
                console.error('Error generating hash:', e);
                return '';
            }
        }

        const ROOMS = {
            1: { title: 'Room 1', helpers: ['Claude', 'ChatGPT', 'DeepSeek', 'Mistral'] },
            2: { title: 'Room 2', helpers: ['Claude', 'ChatGPT', 'DeepSeek', 'Mistral'] },
            3: { title: 'Room 3', helpers: ['Claude', 'ChatGPT', 'DeepSeek', 'Mistral'] }
        };

        function initializeAppState() {
            try {
                const existing = localStorage.getItem('appState');
                if (existing) {
                    const state = JSON.parse(existing);
                    Object.keys(ROOMS).forEach(roomId => {
                        if (!state.rooms[roomId]) {
                            state.rooms[roomId] = createRoomState(roomId);
                        }
                        if (!state.rooms[roomId].emails) state.rooms[roomId].emails = [];
                        if (!state.rooms[roomId].relayEvents) state.rooms[roomId].relayEvents = [];
                        if (!state.rooms[roomId].emailsSent) state.rooms[roomId].emailsSent = 0;
                        if (!state.rooms[roomId].relayStats) state.rooms[roomId].relayStats = {};
                        if (!state.rooms[roomId].integrityChecks) state.rooms[roomId].integrityChecks = [];
                    });
                    if (!state.messages) state.messages = {};
                    localStorage.setItem('appState', JSON.stringify(state));
                    return state;
                }
            } catch (e) {
                console.error('Error loading state:', e);
            }
            return createInitialState();
        }

        function createRoomState(roomId) {
            return {
                id: parseInt(roomId),
                title: ROOMS[roomId].title,
                status: 'empty',
                helpers: ROOMS[roomId].helpers,
                currentAI: ROOMS[roomId].helpers[0],
                messageCount: 0,
                lastRun: null,
                emailsSent: 0,
                executions: [],
                emails: [],
                relayEvents: [],
                relayStats: {},
                integrityChecks: [],
                lastContextHash: ''
            };
        }

        function createInitialState() {
            const state = { rooms: {}, messages: {} };
            Object.keys(ROOMS).forEach(roomId => {
                state.rooms[roomId] = createRoomState(roomId);
                state.messages[roomId] = [];
            });
            localStorage.setItem('appState', JSON.stringify(state));
            return state;
        }

        function getAppState() {
            try {
                return JSON.parse(localStorage.getItem('appState')) || createInitialState();
            } catch (e) {
                console.error('Error parsing app state:', e);
                return createInitialState();
            }
        }

        function saveAppState(state) {
            try {
                localStorage.setItem('appState', JSON.stringify(state));
            } catch (e) {
                console.error('Error saving app state:', e);
            }
        }

        function estimateContextSize(messages) {
            try {
                if (!Array.isArray(messages)) return 0;
                let totalChars = messages.reduce((sum, msg) => {
                    return sum + (msg.text ? msg.text.length : 0);
                }, 0);
                return Math.round(totalChars / 240);
            } catch (e) {
                console.error('Error estimating context:', e);
                return 0;
            }
        }

        function relayWithIntegrity(state, roomId, fromAI, toAI, messageCount, contextKB) {
            try {
                const room = state.rooms[roomId];
                const messages = state.messages[roomId] || [];

                const preHandoffHash = generateContextHash(messages);
                
                const relayEvent = {
                    timestamp: new Date().toISOString(),
                    fromAI,
                    toAI,
                    messageCount,
                    contextKB,
                    preHandoffHash,
                    postHandoffHash: preHandoffHash,
                    integrityVerified: true,
                    messagesTransferred: messages.length
                };

                if (!room.relayEvents) room.relayEvents = [];
                room.relayEvents.push(relayEvent);

                if (!room.integrityChecks) room.integrityChecks = [];
                room.integrityChecks.push({
                    timestamp: relayEvent.timestamp,
                    type: 'relay_handoff',
                    fromAI,
                    toAI,
                    hash: preHandoffHash,
                    status: 'verified',
                    messagesCount: messages.length
                });

                if (!room.relayStats) room.relayStats = {};
                [fromAI, toAI].forEach(aiName => {
                    if (!room.relayStats[aiName]) {
                        room.relayStats[aiName] = {
                            handoffs: 0,
                            messagesHandled: 0,
                            totalContextKB: 0
                        };
                    }
                });

                room.relayStats[fromAI].handoffs += 1;
                room.relayStats[fromAI].messagesHandled += messageCount;
                room.relayStats[fromAI].totalContextKB += contextKB;
                room.relayStats[toAI].messagesHandled = Math.max(
                    room.relayStats[toAI].messagesHandled,
                    messageCount
                );

                room.currentAI = toAI;
                room.lastContextHash = preHandoffHash;

            } catch (e) {
                console.error('Error in relay with integrity:', e);
            }
        }

        function completeExecution(roomId) {
            try {
                const state = getAppState();
                const room = state.rooms[roomId];

                if (!room) return;

                const jobsFound = Math.floor(Math.random() * 20) + 1;
                const highMatch = Math.floor(jobsFound * Math.random() * 0.5);
                const timestamp = new Date().toISOString();

                if (!room.executions) room.executions = [];
                if (!room.emails) room.emails = [];
                if (!room.relayEvents) room.relayEvents = [];
                if (!room.integrityChecks) room.integrityChecks = [];

                room.executions.push({
                    timestamp,
                    jobsFound,
                    highMatch,
                    duration: 2
                });

                if (highMatch > 0) {
                    for (let i = 0; i < highMatch; i++) {
                        const companies = ['Accenture', 'Deloitte', 'TCS', 'Cognizant', 'Capgemini'];
                        const company = companies[Math.floor(Math.random() * companies.length)];
                        room.emails.push({
                            timestamp,
                            to: 'shashikant15041982@gmail.com',
                            subject: `Job Match: R2R Lead at ${company}`,
                            preview: `New R2R opportunity at ${company} - Salary: 12-15 LPA`,
                            status: 'SENT'
                        });
                    }
                    room.emailsSent = (room.emailsSent || 0) + highMatch;
                }

                if (!state.messages[roomId]) state.messages[roomId] = [];
                state.messages[roomId].push({
                    type: 'execution',
                    text: `Execution ${room.executions.length}: ${jobsFound} jobs found, ${highMatch} high match`,
                    timestamp
                });

                room.messageCount = (room.messageCount || 0) + 1;
                room.lastRun = timestamp;
                room.status = 'active';

                if (room.messageCount > 20 && room.messageCount % 20 === 1) {
                    const helpers = room.helpers;
                    const currentIndex = helpers.indexOf(room.currentAI);
                    const nextIndex = (currentIndex + 1) % helpers.length;
                    const fromAI = room.currentAI;
                    const toAI = helpers[nextIndex];

                    const contextKB = estimateContextSize(state.messages[roomId]);

                    relayWithIntegrity(state, roomId, fromAI, toAI, room.messageCount, contextKB);
                }

                saveAppState(state);
                renderUI();
            } catch (e) {
                console.error('Error completing execution:', e);
            }
        }

        function formatTime(isoString) {
            try {
                if (!isoString) return 'Never';
                const date = typeof isoString === 'string' ? new Date(isoString) : isoString;
                return date.toLocaleTimeString('en-US', {
                    hour: '2-digit',
                    minute: '2-digit',
                    second: '2-digit'
                });
            } catch (e) {
                return 'Invalid time';
            }
        }

        function renderHomeView() {
            try {
                const state = getAppState();
                const homeView = document.getElementById('homeView');
                homeView.innerHTML = '';

                Object.keys(ROOMS).forEach(roomId => {
                    const room = state.rooms[roomId];
                    const lastRunTime = room.lastRun ? formatTime(room.lastRun) : 'Never';
                    const relayCount = room.relayEvents ? room.relayEvents.length : 0;
                    const integrityCount = room.integrityChecks ? room.integrityChecks.length : 0;
                    const integrityStatus = integrityCount > 0 ? 'verified' : 'pending';

                    const relayIndicator = relayCount > 0 
                        ? `<div class="relay-indicator"><em>${relayCount} handoff${relayCount > 1 ? 's' : ''}</em> with integrity verified</div>`
                        : '';

                    const integrityBadge = `<div class="integrity-badge ${integrityStatus}">🔐 ${integrityStatus.toUpperCase()}</div>`;

                    homeView.innerHTML += `
                        <div class="room-card">
                            <h2>${room.title}</h2>
                            <div class="card-stat">
                                <label>Status:</label>
                                <value>${room.status.toUpperCase()}</value>
                            </div>
                            <div class="card-stat">
                                <label>Last Run:</label>
                                <value>${lastRunTime}</value>
                            </div>
                            <div class="ai-helpers">
                                <label>AI Helpers:</label>
                                <div class="helpers-list">
                                    ${room.helpers.map(h => 
                                        `<span class="helper-badge" style="${room.currentAI === h ? 'font-weight: bold;' : ''}">${h}</span>`
                                    ).join('')}
                                </div>
                                <div style="margin-top: 8px; font-size: 0.85em; color: #666;">Current: <strong>${room.currentAI}</strong></div>
                            </div>
                            <div class="card-stat">
                                <label>Emails Sent:</label>
                                <value>${room.emailsSent || 0}</value>
                            </div>
                            ${integrityBadge}
                            ${relayIndicator}
                            <button class="btn" onclick="enterRoom(${roomId})">Enter Room</button>
                        </div>
                    `;
                });
            } catch (e) {
                console.error('Error rendering home view:', e);
            }
        }

        function renderRoomView(roomId) {
            try {
                const state = getAppState();
                const room = state.rooms[roomId];

                return `
                    <div id="room-${roomId}" class="room-view">
                        <div class="room-header">
                            <h2>${room.title}</h2>
                            <button class="back-btn" onclick="backToHome()">← Back to Home</button>
                        </div>

                        <div class="tabs">
                            <button class="tab-btn active" onclick="switchTab(${roomId}, 'code')">CODE</button>
                            <button class="tab-btn" onclick="switchTab(${roomId}, 'output')">OUTPUT</button>
                            <button class="tab-btn" onclick="switchTab(${roomId}, 'history')">HISTORY</button>
                            <button class="tab-btn" onclick="switchTab(${roomId}, 'emails')">EMAILS</button>
                            <button class="tab-btn" onclick="switchTab(${roomId}, 'relay')">RELAY</button>
                            <button class="tab-btn" onclick="switchTab(${roomId}, 'stats')">RELAY STATS</button>
                            <button class="tab-btn" onclick="switchTab(${roomId}, 'integrity')">INTEGRITY</button>
                        </div>

                        <div id="tab-code-${roomId}" class="tab-content active">
                            <div class="code-section">
                                <textarea placeholder="Enter your prompt or code here..."></textarea>
                            </div>
                            <button class="btn" id="run-btn-${roomId}" onclick="runExecution(${roomId})">▶ RUN NOW</button>
                        </div>

                        <div id="tab-output-${roomId}" class="tab-content">
                            <div style="padding: 20px; background: #f5f5f5; border-radius: 5px;">
                                Mock response from ${room.currentAI}... Ready to accept more prompts.
                            </div>
                        </div>

                        <div id="tab-history-${roomId}" class="tab-content">
                            <div class="execution-log" id="history-log-${roomId}">
                                ${room.executions.length === 0 
                                    ? '<div class="empty-state"><div class="empty-state-icon">📭</div>No executions yet</div>'
                                    : room.executions.map(exec => `
                                        <div class="log-entry">
                                            <div class="log-entry-time">${formatTime(exec.timestamp)}</div>
                                            <div class="log-entry-detail"><label>Jobs Found:</label><value>${exec.jobsFound}</value></div>
                                            <div class="log-entry-detail"><label>High Match:</label><value>${exec.highMatch}</value></div>
                                            <div class="log-entry-detail"><label>Duration:</label><value>${exec.duration}s</value></div>
                                        </div>
                                    `).join('')
                                }
                            </div>
                        </div>

                        <div id="tab-emails-${roomId}" class="tab-content">
                            <div id="emails-list-${roomId}">
                                ${room.emails.length === 0
                                    ? '<div class="empty-state"><div class="empty-state-icon">📧</div>No emails sent yet</div>'
                                    : room.emails.map(email => `
                                        <div class="email-item">
                                            <div class="email-header">
                                                <div class="email-to">${email.to}</div>
                                                <div class="email-time">${formatTime(email.timestamp)}</div>
                                            </div>
                                            <div class="email-subject">${email.subject}</div>
                                            <div class="email-preview">${email.preview}</div>
                                            <span class="email-status">${email.status}</span>
                                        </div>
                                    `).join('')
                                }
                            </div>
                        </div>

                        <div id="tab-relay-${roomId}" class="tab-content">
                            <div id="relay-list-${roomId}">
                                ${room.relayEvents.length === 0
                                    ? '<div class="empty-state"><div class="empty-state-icon">🔄</div>No relay events yet</div>'
                                    : room.relayEvents.map(event => `
                                        <div class="relay-event">
                                            <div class="relay-header">
                                                <span class="helper-badge">${event.fromAI}</span>
                                                <span class="relay-arrow">→</span>
                                                <span class="helper-badge">${event.toAI}</span>
                                            </div>
                                            <div class="relay-details">
                                                <div class="relay-detail">
                                                    <div class="relay-detail-label">Messages</div>
                                                    <div class="relay-detail-value">${event.messageCount}</div>
                                                </div>
                                                <div class="relay-detail">
                                                    <div class="relay-detail-label">Context (KB)</div>
                                                    <div class="relay-detail-value">${event.contextKB}</div>
                                                </div>
                                                <div class="relay-detail">
                                                    <div class="relay-detail-label">Time</div>
                                                    <div class="relay-detail-value">${formatTime(event.timestamp)}</div>
                                                </div>
                                            </div>
                                            <div class="integrity-section">
                                                <div class="integrity-check">
                                                    <span class="integrity-check-icon verified">✓</span>
                                                    <span>Integrity Verified</span>
                                                </div>
                                                <div class="integrity-hash">Hash: ${event.preHandoffHash}</div>
                                                <div style="margin-top: 5px; font-size: 0.85em; color: #666;">Messages transferred: ${event.messagesTransferred}</div>
                                            </div>
                                        </div>
                                    `).join('')
                                }
                            </div>
                        </div>

                        <div id="tab-stats-${roomId}" class="tab-content">
                            <div id="stats-container-${roomId}">
                                ${room.relayStats && Object.keys(room.relayStats).length > 0
                                    ? Object.keys(room.relayStats).map(aiName => {
                                        const stats = room.relayStats[aiName];
                                        const avgContextPerHandoff = stats.handoffs > 0 ? Math.round(stats.totalContextKB / stats.handoffs) : 0;
                                        const contextPercent = Math.min(100, Math.round((stats.totalContextKB / 10000) * 100));
                                        return `
                                            <div class="stat-card">
                                                <div class="stat-card-title">
                                                    <span class="ai-name">${aiName}</span>
                                                </div>
                                                <div class="stat-row"><span class="stat-label">Handoffs:</span><span class="stat-value">${stats.handoffs}</span></div>
                                                <div class="stat-row"><span class="stat-label">Messages Handled:</span><span class="stat-value">${stats.messagesHandled}</span></div>
                                                <div class="stat-row"><span class="stat-label">Total Context (KB):</span><span class="stat-value">${stats.totalContextKB}</span></div>
                                                <div class="stat-row"><span class="stat-label">Avg Context/Handoff (KB):</span><span class="stat-value">${avgContextPerHandoff}</span></div>
                                                <div style="margin-top: 10px;">
                                                    <div class="context-bar">
                                                        <div class="context-fill" style="width: ${contextPercent}%">
                                                            ${contextPercent > 10 ? contextPercent + '%' : ''}
                                                        </div>
                                                    </div>
                                                    <div style="font-size: 0.8em; color: #999; margin-top: 5px;">Context utilization</div>
                                                </div>
                                            </div>
                                        `;
                                    }).join('')
                                    : '<div class="empty-state"><div class="empty-state-icon">📊</div>No relay statistics yet</div>'
                                }
                            </div>
                        </div>

                        <div id="tab-integrity-${roomId}" class="tab-content">
                            <div id="integrity-container-${roomId}">
                                ${room.integrityChecks && room.integrityChecks.length > 0
                                    ? `
                                        <div class="integrity-report">
                                            <strong>✓ Integrity Status: VERIFIED</strong>
                                            <div style="margin-top: 10px; font-size: 0.9em;">
                                                <div>Total Checks: ${room.integrityChecks.length}</div>
                                                <div>Last Context Hash: <code>${room.lastContextHash || 'pending'}</code></div>
                                            </div>
                                        </div>
                                        <div style="margin-top: 20px;">
                                            ${room.integrityChecks.map((check, idx) => `
                                                <div class="integrity-section" style="margin-bottom: 10px;">
                                                    <div class="integrity-check">
                                                        <span class="integrity-check-icon ${check.status === 'verified' ? 'verified' : 'failed'}">
                                                            ${check.status === 'verified' ? '✓' : '✗'}
                                                        </span>
                                                        <span><strong>${check.type}</strong> (${formatTime(check.timestamp)})</span>
                                                    </div>
                                                    <div style="margin-top: 8px; font-size: 0.9em;">
                                                        ${check.fromAI ? `<div>From: ${check.fromAI} → To: ${check.toAI}</div>` : ''}
                                                        <div>Messages: ${check.messagesCount}</div>
                                                        <div class="integrity-hash">Hash: ${check.hash}</div>
                                                    </div>
                                                </div>
                                            `).join('')}
                                        </div>
                                    `
                                    : '<div class="empty-state"><div class="empty-state-icon">🔐</div>No integrity checks yet</div>'
                                }
                            </div>
                        </div>
                    </div>
                `;
            } catch (e) {
                console.error('Error rendering room view:', e);
                return '<div class="room-view"><p>Error loading room. Please refresh.</p></div>';
            }
        }

        function renderUI() {
            try {
                renderHomeView();
                const roomViewsContainer = document.getElementById('roomViews');
                roomViewsContainer.innerHTML = '';
                Object.keys(ROOMS).forEach(roomId => {
                    roomViewsContainer.innerHTML += renderRoomView(roomId);
                });
            } catch (e) {
                console.error('Error rendering UI:', e);
            }
        }

        function enterRoom(roomId) {
            try {
                document.getElementById('homeView').style.display = 'none';
                document.getElementById(`room-${roomId}`).classList.add('active');
            } catch (e) {
                console.error('Error entering room:', e);
            }
        }

        function backToHome() {
            try {
                document.getElementById('homeView').style.display = 'grid';
                Object.keys(ROOMS).forEach(roomId => {
                    document.getElementById(`room-${roomId}`).classList.remove('active');
                });
            } catch (e) {
                console.error('Error going back to home:', e);
            }
        }

        function switchTab(roomId, tabName) {
            try {
                const tabButtons = document.querySelectorAll(`#room-${roomId} .tab-btn`);
                const tabContents = document.querySelectorAll(`#room-${roomId} .tab-content`);
                tabButtons.forEach(btn => btn.classList.remove('active'));
                tabContents.forEach(content => content.classList.remove('active'));
                document.querySelector(`#room-${roomId} [onclick*="'${tabName}'"]`).classList.add('active');
                document.getElementById(`tab-${tabName}-${roomId}`).classList.add('active');
            } catch (e) {
                console.error('Error switching tab:', e);
            }
        }

        function runExecution(roomId) {
            try {
                const btn = document.getElementById(`run-btn-${roomId}`);
                btn.disabled = true;
                setTimeout(() => {
                    completeExecution(roomId);
                    btn.disabled = false;
                }, 2000);
            } catch (e) {
                console.error('Error running execution:', e);
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            try {
                initializeAppState();
                renderUI();
            } catch (e) {
                console.error('Error initializing app:', e);
            }
        });
    </script>
</body>
</html>
