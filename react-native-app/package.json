{
  "name": "multi-room-platform",
  "version": "1.0.0",
  "description": "Multi-Room Project Platform - Native Mobile App",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint .",
    "build-android": "cd android && ./gradlew assembleRelease",
    "build-ios": "xcodebuild -workspace ios/MultiRoom.xcworkspace -scheme MultiRoom -configuration Release"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-native": "^0.73.0",
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/bottom-tabs": "^6.5.0",
    "@react-native-async-storage/async-storage": "^1.19.0",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-react": "^7.23.0",
    "jest": "^29.7.0",
    "eslint": "^8.50.0"
  }
}
